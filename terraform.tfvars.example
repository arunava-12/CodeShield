# Example values only. Copy to terraform.tfvars and review `terraform plan` first.
aws_region     = "ap-south-1"
project_name   = "CodeShield"
environment    = "dev"
vpc_cidr       = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
instance_type  = "t3.micro"
allowed_ssh_cidr = "127.0.0.1/32"
domain_name = "codeshield.example.com" # Replace with a domain you control and point its A record to the EC2 public IP.
ami_id = "ami-0c562b0a28fe197f3" # Confirm this AMI exists in your selected AWS region.
