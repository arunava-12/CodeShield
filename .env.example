# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
APP_VERSION=1.1.0
# Set a long random token to require API authentication.
SCAN_API_TOKEN=
# Local persistent scan history database path.
CODE_SHIELD_DB_PATH=./data/codeshield.db
SCAN_RATE_LIMIT_REQUESTS=10
SCAN_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REPOSITORY_FILES=50000
# Optional: URL of the FastAPI backend in LLM-BenchMarking-Platform.
# Local Flask: http://127.0.0.1:8000; Docker Desktop: http://host.docker.internal:8000
LLM_BENCHMARK_API_URL=
